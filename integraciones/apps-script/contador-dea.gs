/** Public aggregate visits only. No identity or role permissions. */
function deaVisitsSheet_(name,headers){const book=deaBook_();let sh=book.getSheetByName(name);if(!sh){sh=book.insertSheet(name);sh.appendRow(headers);sh.setFrozenRows(1);}if(sh.getRange(1,1,1,headers.length).getDisplayValues()[0].join('|')!==headers.join('|'))throw Error('Esquema de visitas incompatible');return sh;}
function deaVisitsData_(stats){const today=Utilities.formatDate(new Date(),'Europe/Madrid','yyyy-MM-dd'),days={};let total=0;const recovered=deaTab_('VISITAS_WEB_RECUPERACION').getDataRange().getValues().slice(1);recovered.forEach(r=>{const d=String(r[0]);if(/^\d{4}-\d{2}-\d{2}$/.test(d)&&Number.isSafeInteger(r[1])&&r[1]>=0){days[d]=(days[d]||0)+r[1];total+=r[1];}});const events=deaVisitsSheet_('VISITAS_WEB_EVENTOS',['fecha_madrid','id_visita_sha256','alta_utc']);events.getDataRange().getValues().slice(1).forEach(r=>{const d=String(r[0]);if(/^\d{4}-\d{2}-\d{2}$/.test(d)){days[d]=(days[d]||0)+1;total++;}});const baseline=deaVisitsSheet_('VISITAS_WEB_BASELINE',['clave','valor']);const conf={};baseline.getDataRange().getValues().slice(1).forEach(r=>{conf[String(r[0])]=r[1];});const complete=conf.completo===true;Object.keys(conf).filter(k=>/^dia:\d{4}-\d{2}-\d{2}$/.test(k)).forEach(k=>{const n=Number(conf[k]);if(!Number.isSafeInteger(n)||n<0)throw Error('Historial no válido');days[k.slice(4)]=(days[k.slice(4)]||0)+n;});if(conf.total_v3!==undefined){const n=Number(conf.total_v3);if(!Number.isSafeInteger(n)||n<0)throw Error('Acumulado no válido');total+=n;}if(complete&&conf.total_v3===undefined)throw Error('Falta el acumulado histórico');const out={total:total,hoy:days[today]||0,fecha:today,zona:'Europe/Madrid',historicoCompleto:complete,criterio:'Cada entrada o recarga de la página cuenta una visita'};if(stats){const first=Object.keys(days).sort()[0]||today;out.desde=first;out.historial=[];for(let t=Date.parse(first+'T12:00:00Z');t<=Date.parse(today+'T12:00:00Z')&&out.historial.length<7300;t+=86400000){const d=Utilities.formatDate(new Date(t),'Europe/Madrid','yyyy-MM-dd');out.historial.push({fecha:d,visitas:days[d]||0});}out.historialCompleto=complete;}return out;}
function deaVisitsPublic_(p){let out;try{const token=String(p.session||'');if(token&&!/^[a-f0-9]{32}$/.test(token))throw Error('Identificador inválido');const lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('Contador ocupado');try{let registered=false;if(token){const day=Utilities.formatDate(new Date(),'Europe/Madrid','yyyy-MM-dd'),hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join(''),sh=deaVisitsSheet_('VISITAS_WEB_EVENTOS',['fecha_madrid','id_visita_sha256','alta_utc']);const seen=sh.getDataRange().getDisplayValues().slice(1).some(r=>r[0]===day&&r[1]===hash);if(!seen){sh.appendRow([day,hash,new Date().toISOString()]);SpreadsheetApp.flush();registered=true;}}out=deaVisitsData_(p.stats==='1');if(token)out.registrada=registered;}finally{lock.releaseLock();}}catch(e){out={error:'No se pudieron consultar las visitas'};}return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);}
