function deaDirectLogin_(app){app=String(app||'');if(app&&!deaFounderApp_(app)&&!deaCargoApp_(app))throw Error('Miniapp no disponible');const url=deaBeginLogin({app:app,remember:true});return HtmlService.createHtmlOutput('<!doctype html><html lang="es"><meta charset="utf-8"><meta name="referrer" content="no-referrer"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Discord · DEA</title><body style="background:#081728;color:#e9c780;font:18px system-ui;padding:30px"><h1>Acceso DEA con Discord</h1><p>Autoriza tu cuenta personal de Discord. DEA no solicita contraseñas.</p><a target="_top" rel="noreferrer" style="color:white" href="'+deaRebindEscape_(url)+'">Continuar con Discord</a></body></html>');}
